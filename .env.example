# Enlace de descarga del zip de datos (Google Drive «cualquiera con el enlace»); si está vacío se usa Hugging Face (privado)
MAVERICKS_ASSETS_URL=
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=1
LLM_RETRIES=2
SIMULATION_TIMEOUT=900
CIS_DIR=data/processed
ANCHOR_MAX_SHIFT=0.15
ANCHOR_SHRINKAGE=25
ANCHOR_DIRECT_SIMILARITY=0.9
ANCHOR_PRIOR_SIMILARITY=0.55
STABILITY_RUNS=1
STABILITY_TEMPERATURE=0.7
CALIBRATION_PATH=data/processed/calibration.json
INTERVAL_ALPHA=0.1
MIN_CALIBRATION_CASES=20
EXTERNAL_MODEL=
EXTERNAL_BASE_URL=
EXTERNAL_API_KEY=
EMBEDDING_MODEL_PATH=
CHROMA_PATH=data/processed/chroma

# Interfaz: modo por defecto (rapido_sin_llm | llm_completo), peso del LLM en el modo con LLM y tiempo máximo de su explicación
DEFAULT_PRESET=rapido_sin_llm
LLM_BLEND_WEIGHT=0.3
EXPLANATION_TIMEOUT=20
